# macOS
.DS_Store
.AppleDouble
.LSOverride

# Directory metadata
.directory

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# Log files
*.log

# Build artifacts and directories
**/build/
build/
build_*/

*.o
*.a
*.out
*.exe

# Keep the vendored ESP audio codec link-time libraries; the component
# cannot link without them.
!components/esp_audio_codec/lib/
!components/esp_audio_codec/lib/**

# ESP-IDF specific build outputs
*.bin
*.elf
*.map
flasher_args.json
sdkconfig.old
sdkconfig

# ESP-IDF dependencies
# For older versions or manual component management
/components/.idf/
**/components/.idf/
# For modern ESP-IDF component manager
managed_components/
# If ESP-IDF tools are installed/referenced locally to the project
.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Python environment files
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/

# Virtual environment folders
venv/
.venv/
env/

# Language Servers
.clangd/
.ccls-cache/
compile_commands.json

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# User-specific configuration files
*.user
*.workspace
*.suo
*.sln.docstates

# Secrets and local environment files (never commit these)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.der
*.jks
*.keystore
*.kdbx
id_rsa*
id_ed25519*
secrets/
credentials/
credentials.*

# Local databases and test caches
*.db
*.sqlite
*.sqlite3
.pytest_cache/
.mypy_cache/
.ruff_cache/
