# ---------------------------------------------------------------------------
# Copy to .env and edit.  Never commit real API keys or tokens.
# ---------------------------------------------------------------------------

DATA_DIR=./data
# Host bind address/port for the Docker Compose service.  Keep the default
# 8080 for a direct LAN test, or use 127.0.0.1 + a free port behind Caddy/Nginx.
WATCH_BIND=0.0.0.0
WATCH_PORT=8080
# ADMIN_TOKEN protects the dashboard/API. Empty means no admin auth.
# Generate a random value, e.g. openssl rand -hex 24, and never use the
# placeholder below on a reachable host.
ADMIN_TOKEN=change-me-admin
# WATCH_TOKEN is sent by the ESP32 watch as "Authorization: Bearer ...".
WATCH_TOKEN=change-me-watch
MAX_UPLOAD_MB=512

# ---- AI (DeepSeek API only) -----------------------------------------------
# The server calls DeepSeek's OpenAI-compatible chat API; no local LLM.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_TEMPERATURE=0.7
AI_TIMEOUT_S=120
AI_MAX_TOKENS=1024
# Response length is controlled by the prompt/user request, not by a fixed
# character cap. Override the default watch prompt if you need a different style.
# WATCH_SYSTEM_PROMPT=你是 ESP32 手表上的中文语音助手……

# ---- TTS ------------------------------------------------------------------
# piper (local, recommended) | cosyvoice (HTTP service) | none
TTS_PROVIDER=piper
PIPER_VOICE=zh_CN-huayan-medium
PIPER_MODEL_DIR=./data/models/piper
# Optional: use an already running `python -m piper.http_server` instead.
PIPER_URL=
# Set this to an .onnx path to bypass voice-name lookup.
PIPER_MODEL=
AUTO_DOWNLOAD_PIPER=1
TTS_CACHE=1
# Uploaded Piper models are limited to this size.  256 MB is enough for the
# medium voices; increase it only if you use a larger custom voice.
MAX_TTS_MODEL_MB=256

# Optional CosyVoice HTTP adapter. It must accept JSON
# {"text": "...", "speaker": "...", "format": "wav"} and return WAV.
COSYVOICE_URL=
COSYVOICE_TOKEN=
COSYVOICE_SPEAKER=中文女

# ---- ASR (watch voice input) ---------------------------------------------
# Recommended local option (no provider/key): start the optional Speaches
# container and use:
#   docker compose --profile asr up -d
#   ASR_PROVIDER=openai_compatible
#   ASR_BASE_URL=http://speaches:8000/v1
#   ASR_API_KEY=
#   ASR_MODEL=Systran/faster-whisper-small
# The compose file sets WHISPER__TTL=-1 so the model stays loaded; without it
# Speaches unloads after 5 min and the next PTT may hang while re-downloading.
#
# Cloud options:
#   OpenAI:     https://api.openai.com/v1       model=whisper-1
#   Groq:       https://api.groq.com/openai/v1  model=whisper-large-v3-turbo
#   SiliconFlow https://api.siliconflow.cn/v1   model=FunAudioLLM/SenseVoiceSmall
ASR_PROVIDER=none
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_LANGUAGE=zh
# Optional vocabulary hint; keep empty if the provider rejects it.
ASR_PROMPT=
ASR_TIMEOUT_S=60
# Synthetic user prompt handed to DeepSeek when PTT contains no speech.
EMPTY_ASR_PROMPT=用户刚刚按下了语音键，但没有检测到语音内容（空音频）。请用简短中文回复，提示用户再说一遍。
# Safety net if a watch never sends listen:stop after listen:start.
PTT_MAX_S=30

# ---- Watch media ----------------------------------------------------------
WATCH_VIDEO_WIDTH=204
WATCH_VIDEO_HEIGHT=138
WATCH_VIDEO_FPS=12
WATCH_VIDEO_QUALITY=72
# Set to 0 to test pure-video playback if the watch UI stutters with audio.
WATCH_VIDEO_AUDIO=1
WATCH_AI_SAMPLE_RATE=24000
WATCH_AI_FRAME_MS=60

LOG_LEVEL=INFO
