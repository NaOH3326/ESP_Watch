CONFIG_IDF_TARGET="esp32s3"

# 板载 W25Q128 (16 MB) + ESP32-S3R8 片内 8 MB 八线 PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# WatchShell + FAT 存储分区
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 主控制台：USB-Serial-JTAG（GPIO19/20 -> CH334P 下行口 2）
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 文件系统 / HTTP / TLS
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

# 主任务 / 事件任务余量
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000

# 工厂测试需要 BLE；WatchShell 不使用 BLE，但保留组件以便随时切回
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# 可选的默认配置（也可以启动后在网页/串口里改）
CONFIG_WATCH_WIFI_SSID=""
CONFIG_WATCH_WIFI_PASSWORD=""
CONFIG_WATCH_AI_URL=""
CONFIG_WATCH_AI_TOKEN=""
CONFIG_WATCH_VIDEO_URL=""
CONFIG_WATCH_VIDEO_TOKEN=""
CONFIG_WATCH_AP_SSID="ESP-Watch"
CONFIG_WATCH_AP_PASSWORD="watchshell"

# Power / startup behavior
CONFIG_WATCH_NORMAL_SPLASH_MS=450
CONFIG_WATCH_FAST_SPLASH_MS=60
CONFIG_WATCH_IDLE_POWEROFF_SEC=120
# CONFIG_WATCH_IDLE_OFF_WHILE_CHARGING is not set
CONFIG_WATCH_LOW_BATT_MV=3400
CONFIG_WATCH_LOW_BATT_RECOVER_MV=3550
CONFIG_WATCH_LOW_BATT_WARN_SEC=3
